{
  "name": "agromat-content-analytics",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0 <25"
  },
  "scripts": {
    "test": "node --test tests/*.test.mjs",
    "dev": "next dev",
    "build": "next build",
    "start": "next start -p 3000",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "local-parser-runner": "node scripts/local-parser-runner.mjs",
    "santechshara:login": "node scripts/santechshara-login.mjs",
    "santechshara:clean-login": "SANTECHSHARA_RESET_PROFILE=true node scripts/santechshara-login.mjs",
    "santechshara:worker": "node scripts/santechshara-worker.mjs",
    "santechshara:categories": "node scripts/santechshara-category-worker.mjs",
    "vannaja:worker": "node scripts/vannaja-worker.mjs"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1064.0",
    "@google-cloud/bigquery": "^8.3.1",
    "@supabase/supabase-js": "^2.106.2",
    "@upstash/redis": "^1.36.4",
    "clsx": "^2.1.1",
    "ioredis": "^5.11.1",
    "next": "15.5.24",
    "playwright": "^1.60.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "sharp": "0.35.4",
    "tailwind-merge": "^2.5.2",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.2.0",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "autoprefixer": "^10.0.1",
    "eslint": "^9.18.0",
    "eslint-config-next": "15.5.24",
    "postcss": "^8",
    "prettier": "^3.8.1",
    "tailwindcss": "^3.4.1",
    "typescript": "^5.9.3"
  },
  "overrides": {
    "nanoid": "3.3.18",
    "next": {
      "postcss": "8.5.23"
    }
  },
  "allowScripts": {
    "unrs-resolver@1.12.2": true
  }
}
